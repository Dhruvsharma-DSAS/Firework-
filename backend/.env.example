# Copy to backend/.env for local work. On Render / Railway type these in the dashboard instead (never commit real values).
# --- required ---
FIRMS_MAP_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# --- CORS: your Vercel URL(s), comma separated; the regex also allows Vercel preview URLs ---
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=
# --- Earth Engine (Context layers): project + one way to sign in on a server ---
EE_PROJECT=
EARTHENGINE_TOKEN=
EE_SERVICE_ACCOUNT_JSON=
# --- AI assistant (any subset) ---
GROQ_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
# --- optional / local only ---
SUPABASE_SERVICE_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
OPENAQ_API_KEY=
DATABASE_URL=
FIRMS_DAY_RANGE=1
MAX_POINTS=20000
